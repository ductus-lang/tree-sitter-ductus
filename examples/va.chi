metrics{
  u=100;
}

params {
  nib_angle = 30 in 0..360;
  nib_width = 100 in 10..200;

}

glyph va: U+006F {
  advance =  15u;
  node m = (3u, 0) dir 135 width nib_width nib nib_angle;
  node n = (0, 5u) dir up width nib_width nib nib_angle;
  node o = (5u, 10u) dir right width nib_width nib nib_angle;
  node p = (10u, 5u) dir down width nib_width nib nib_angle;
  node q = (7u, 0) dir 215 width nib_width nib nib_angle;
  node r = q.pos + (7u, 0) dir right width nib_width nib nib_angle;
  node s = r.pos + (0, 10u) dir up width nib_width nib nib_angle;
  guide pat =  m.pos .. n.pos..o.pos..p.pos..q.pos--r.pos--s.pos;

  contour c1 =  m.right .. n.right..o.right..p.right..q.right
  --r.right--r.left
  -- q.left..p.left..o.left..n.left..m.left
  --cycle;
 contour c2 = r.left --s.left -- s.right --r.right--cycle;
}

