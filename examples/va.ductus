metrics{
  u=100;
}

params {
  nib_angle = 30 in 0..360;
  nib_width = 100 in 10..200;

}

glyph va: U+006F {
  advance =  15u;
  razor = pen(nib_width, 0, nib_angle);
  node m = (3u, 0) dir 135 pen razor;
  node n = (0, 5u) dir up pen razor;
  node o = (5u, 10u) dir right pen razor;
  node p = (10u, 5u) dir down pen razor;
  node q = (7u, 0) dir 215 pen razor;
  node r = q.pos + (7u, 0) dir right pen razor;
  node s = r.pos + (0, 10u) dir up pen razor;
  guide pat =  m.pos .. n.pos..o.pos..p.pos..q.pos--r.pos--s.pos;
  contour c1 =  m.right .. n.right..o.right..p.right..q.right
   -- q.left..p.left ..o.left..n.left..m.left
  --cycle;
  contour c2 = q.left --r.left -- r.right --q.right--cycle;
  contour c3 = r.right --s.right -- s.left --r.left--cycle;
}

