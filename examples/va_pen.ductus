# The va bowl drawn with an ellipse pen instead of a razor.
# The pen's height keeps the stroke from collapsing to zero where the
# travel direction crosses the pen axis, and terminals trace the pen
# shape through .tip / .tail.

metrics {
  u = 100;
}

params {
  pen_width  = 100 in 10..200;
  pen_height = 20 in 1..100;
  pen_angle  = 30 in 0..180;
}

main = pen(pen_width, pen_height, pen_angle);

glyph va : U+006F {
  advance = 15u;

  node m = (3u, 0)   dir 135   pen main;
  node n = (0, 5u)   dir up    pen main;
  node o = (5u, 10u) dir right pen main;
  node p = (10u, 5u) dir down  pen main;
  node q = (7u, 0)   dir 215   pen main;
  node r = q.pos + (7u, 0)  dir right pen main;
  node s = r.pos + (0, 10u) dir up    pen main;

  guide skeleton = m.pos .. n.pos .. o.pos .. p.pos .. q.pos -- r.pos -- s.pos;

  # Bowl: right bank out, around the q terminal, left bank back, and
  # around the m terminal to close. The pen's tangent at .tip/.tail is
  # perpendicular to the travel direction, so the direction constraints
  # below trace the ellipse.
  contour bowl =
      {m.dir} m.right .. n.right .. o.right .. p.right .. q.right
      {q.dir} .. {q.dir + 90} q.tip .. {q.dir + 180} q.left
      .. p.left .. o.left .. n.left .. m.left
      {m.dir + 180} .. {m.dir - 90} m.tail .. cycle;

  # Bar + stem: one stroke q -> r -> s with a 90-degree turn at r. The
  # outer shoulder traces the pen through an intermediate travel
  # direction; the inner corner is the intersection of the two left
  # banks. Terminals: tail cap at q2, tip cap at s.
  node q2 = q.pos dir right pen main;
  node rj = r.pos dir 45 pen main;
  node r2 = r.pos dir up pen main;
  inner = intersection(q2.left -- r.left, r2.left -- s.left);

  contour arm =
      {q2.dir} q2.right -- r.right
      {right} .. rj.right .. {up}
      r2.right -- s.right
      {s.dir} .. {s.dir + 90} s.tip .. {s.dir + 180} s.left
      -- inner -- q2.left
      {q2.dir + 180} .. {q2.dir - 90} q2.tail .. cycle;
}
