{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ductus",
      "camelcase": "Ductus",
      "title": "Ductus",
      "scope": "source.ductus",
      "file-types": [
        "ductus"
      ],
      "injection-regex": "^ductus$",
      "class-name": "TreeSitterDuctus"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Ductus graphical programming language",
    "authors": [
      {
        "name": "Santhosh Thotingal",
        "email": "santhosh.thottingal@gmail.com",
        "url": "https://thottingal.in/"
      }
    ],
    "links": {
      "repository": "https://github.com/ductus-lang/tree-sitter-ductus"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}